# Dart / Flutter
.dart_tool/
.packages

pubspec.lock
# Build outputs. Anchored so the rule can never match source directories
# like packages/oka_android/lib/src/build/ — pub publish excludes
# gitignored files, which would ship oka_android without its build
# subsystem.
/build/
packages/*/build/
# IDE
.idea/
.vscode/
*.iml
*.ipr
*.iws
rust_wrapper/flutter_assets/
# Build cache
.oka_cache/
# Legacy persistent Chrome profile location; it may still contain cookies and
# login state from older configurations. Current/custom build dirs need their
# own ignore rule if they are outside .oka_cache/.
.oka/build/chrome-profiles/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Test coverage
coverage/

# Local configuration
*.local.yaml
example/pubspec_overrides.yaml


# Skill Steward benchmark evidence (machine-local)
.steward/benchmark-summaries/*.json
